# Supabase
# For evaluation, these values are provided separately with the shared backend.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Mapbox
# Evaluators should use their own token unless one is explicitly provided.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Resend Email
# Optional unless email delivery itself is being tested.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Primap <no-reply@primap.org>

# Guardian OTP SMS
# Required when testing under-18 account creation with real SMS delivery.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
TWILIO_FROM_PHONE=
GUARDIAN_OTP_SECRET=your_guardian_otp_hash_secret
GUARDIAN_OTP_TEST_CODE=

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_cron_secret
