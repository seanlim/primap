# Supabase
# For evaluation, these values are provided separately with the shared backend.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local Development
# See README on where to find these tokens
# Includes local supabase keys and optional Google Auth Provider keys
# NEXT_PUBLIC_SUPABASE_URL=your_local_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_local_supabase_service_role_key
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# Resend Email
# Optional unless email delivery itself is being tested.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Primap <no-reply@primap.org>

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_cron_secret
